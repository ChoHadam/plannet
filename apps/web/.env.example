# OpenGateway API Configuration
# OpenAI-compatible API gateway for multiple LLM providers
OPENGATEWAY_API_KEY=your_api_key_here
OPENGATEWAY_BASE_URL=https://your-opengateway-host/v1
OPENGATEWAY_MODEL=anthropic/claude-3-haiku-20240307

# Auth (Spring apps/api 소유) — docs/web-auth-integration.md
# 'true'일 때만 로그인 UI가 켜지고 /api/chat이 세션을 검증한다. 값이 없으면 꺼짐(opt-in).
# 꺼져 있으면 AI 어시스턴트(/api/chat)는 항상 거부된다.
AUTH_ENABLED=false
# Web 서버가 세션을 확인할 Spring 내부 주소 (서버 전용, 브라우저에 노출되지 않음)
# 로컬 개별 실행: http://127.0.0.1:8080 · 로컬 k8s: http://mandalart-api:8080
API_INTERNAL_URL=http://127.0.0.1:8080
# 선택: 세션 쿠키 이름(기본 PLANNET_SESSION), 확인 timeout(ms, 기본 2000)
# AUTH_SESSION_COOKIE_NAME=PLANNET_SESSION
# AUTH_API_TIMEOUT_MS=2000
# 선택: CSRF 허용 origin 고정 (쉼표 구분). 없으면 요청 Host와 Origin을 비교한다.
# APP_ORIGINS=https://plannet.example.com

# AI 사용 제한 (프로세스 메모리, replica별·재시작 시 초기화)
# AI_RATE_LIMIT_PER_MINUTE=5
# AI_RATE_LIMIT_PER_DAY=50
# AI_GLOBAL_LIMIT_PER_DAY=500

# 서버 파일 백업(/api/backup) — 로컬 개인용. 인증이 켜지면 항상 꺼진다.
# 명시하지 않으면 next dev에서만 켜지고 프로덕션 빌드에서는 꺼진다.
# LOCAL_BACKUP_ENABLED=true
# LOCAL_BACKUP_DIR=.local-backup

# Available models (examples):
# - anthropic/claude-3-haiku-20240307
# - anthropic/claude-3-5-haiku-20241022
# - anthropic/claude-3-7-sonnet-20250219
# - openai/gpt-4o-mini
# - openai/gpt-4o
# - vertex-ai/gemini-2.5-flash
