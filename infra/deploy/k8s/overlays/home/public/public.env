# 홈 클러스터 공개 주소 (비밀값 아님). 세 값은 같은 origin을 가리킨다.
PUBLIC_HOST=plannet.mhd-mhd.duckdns.org
APP_ORIGINS=https://plannet.mhd-mhd.duckdns.org
# Google Console "승인된 리디렉션 URI"에 등록된 값 (docs/guides/home-server-migration.md).
GOOGLE_REDIRECT_URI=https://plannet.mhd-mhd.duckdns.org/login/oauth2/code/google
# ingress-nginx controller pod 대역. docker-desktop 의 pod 네트워크는 10.1.0.0/16 이다.
# 확인: kubectl -n ingress-nginx get pod -o wide
PLANNET_TRUSTED_PROXIES=10\.1\.\d{1,3}\.\d{1,3}
