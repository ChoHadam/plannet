# Spring API 설정 (비밀값 아님). 값을 바꾸면 ConfigMap 이름 해시가 바뀌어 pod가 새로 뜬다.
# prod 프로필: Secure 쿠키, 신뢰 프록시의 X-Forwarded-* 만 반영,
# Google client·공개 callback·신뢰 프록시·DB 연결 정보가 없으면 기동 실패.
SPRING_PROFILES_ACTIVE=prod
# 공개 배포는 PostgreSQL 저장 필수. DB 자격 증명은 api.yaml의 필수 Secret 참조로만 주입한다.
PLANNET_STORAGE_ENABLED=true
PLANNET_SESSION_TIMEOUT=8h
PLANNET_LOGIN_SUCCESS_URL=/
PLANNET_LOGIN_FAILURE_URL=/
# limits.memory 대비 힙 비율. non-heap 여유를 남긴다.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=60.0
