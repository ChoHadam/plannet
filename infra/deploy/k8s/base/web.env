# Web 서버 설정 (비밀값 아님). 값을 바꾸면 ConfigMap 이름 해시가 바뀌어 pod가 새로 뜬다.
# 로그인 UI·AI 보호. 공개 배포는 항상 true.
AUTH_ENABLED=true
# Web 서버가 세션을 확인할 Spring 내부 주소 (Service 이름)
API_INTERNAL_URL=http://plannet-api:8080
AUTH_API_TIMEOUT_MS=2000
# 공용 서버 파일 백업은 사용자 구분이 없어 공개 환경에서 명시적으로 끈다.
# (AUTH_ENABLED=true면 코드에서도 항상 차단된다. 설정이 바뀌어도 열리지 않게 이중으로 둔다)
LOCAL_BACKUP_ENABLED=false
# AI 호출 한도: 사용자별 분당/24시간, 프로세스 전체 24시간. 프로세스 메모리라 재시작 시 초기화된다.
AI_RATE_LIMIT_PER_MINUTE=5
AI_RATE_LIMIT_PER_DAY=50
AI_GLOBAL_LIMIT_PER_DAY=500
OPENGATEWAY_BASE_URL=https://apis.opengateway.ai/v1
OPENGATEWAY_MODEL=z-ai/glm-5.2-ultrafast
