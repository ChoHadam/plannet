# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/apps/*/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/apps/*/coverage
/test-results
/apps/*/test-results
/playwright-report
/apps/*/playwright-report

# next.js
/.next
/apps/*/.next
/out
/apps/*/out

# production
/build
/apps/*/build

# gradle
/.gradle
/apps/*/.gradle

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!apps/*/.env.example

# vercel
.vercel
apps/*/.vercel

# IDE
.idea/
.vscode/

# typescript
*.tsbuildinfo
next-env.d.ts

# local docs
ROADMAP.md
CLAUDE.md

# local data backups (dev only)
.local-backup/

# local kubernetes manifests
/k8s/local/
